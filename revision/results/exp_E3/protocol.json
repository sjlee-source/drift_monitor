  "crn": "all policies and both workflows share streams within (role, cond, path)"
 },
 "budget": {
  "B": 6000,
  "qbar": 0.2000066668888963,
  "rule": "pathwise hard cap B; W-A: forced p=1 when remaining scope items <= remaining scope budget (exact spending); W-B: pacing only (no forcing possible on passed items), audits used reported",
  "block": {
   "size": 3000,
   "block_budget": "round(B*end/H)-round(B*start/H)"
  },
  "floor": 0.02,
  "floor_rule": "paced targeted policies: p=clip(g(S)*kappa, eps, 1), kappa=(Brem/items_rem)/qbar; p=0 only when the (scope) budget is exhausted (counted as floor violations); P1/P2 exact-uniform p=Brem/items_rem; P3 original mechanics (base/boost, p=0 when exhausted, forced at end)"
 },
 "workflows": {
  "WA": "any item auditable; audited defective -> label X=M",
  "WB": "flagged items (S>=c) always reviewed free (caught-defect labels X=0, weight 1, not charged); audits only on passed items; audited passed defective -> miss label X=1, weight 1/p_t"
 },
 "estimand": "r_t = P(M_t=1 | Z_t=1) = misses/(misses+caught defects) (both workflows); W-B HT ratio sum(w X)/sum(w) over defect labels",
 "monitors": {
  "primary": "mixture SR (original stakes LAM=[.02,.05,.10,.20,.40]/.09, log mean of 5 SR components)",
  "secondary": "Betting (gain 4, cap 9, window 50, Hajek-weighted window mean)",
  "increment": "D = wt*(X - r0); W-A P1-P3 wt=1 (selection independent of current item given past: plain original monitors); W-A P4-P6 wt=qbar/p_t (IPW, normalized so uniform -> 1); W-B wt=1 caught, 1/p_t miss",
  "clipping": "no weight clipping beyond the floor eps (wt <= qbar/eps = 10 in W-A, 1/eps = 50 in W-B); stakes capped at capf/(r0*b_t), capf=0.99 (mSR), 0.9 (Betting: cap 9 * r0), b_t = F_{t-1}-measurable bound on the weight of any possible negative-increment label of item t (W-A IPW: qbar/clip(kappa_t*min_{s>=c} g(s), eps, 1); W-A P1-P3 and W-B: 1)",
  "validity": "item-level increments have E[D_t|F_{t-1}] = const*pi*(r_t - r0) <= 0 under every admissible path, stakes are predictable (constant delay => arrival order = origin order), every factor >= 0.01: Betting log-wealth is a nonnegative supermartingale (Ville: native threshold log(1/0.02) bounds FA over any horizon by 0.02); mixture SR is an e-SR (ARL guarantee). Thresholds actually used are empirically calibrated (two-point null). Native Betting FA reported as a theory check."
 },
 "policies_WA": {
  "P1": "horizon-uniform",
  "P2": "block-uniform (3000)",
  "P3": "warning-boost (original): desired q=base (0.05/0.20), 0.5 while mSR stat >= threshold/4; horizon/block budgets (4 variants)",
  "P4": "uncertainty: g = a*u(1-u)",
  "P5": "score-stratified: g_h proportional to P(Z=1|stratum h)",
  "P6": "Neyman: g_h proportional to sd of Z(M-r0) in stratum h, unit cost (cost-sensitive with equal costs = Neyman; no audit-cost data available). Deviation from brief: sd of the HT target Z(M-r0) used instead of sd of the label indicator Z, because Z(M-r0) is the quantity whose HT sum the monitor uses."
 },
 "policies_WB": {
  "B1": "uniform over passed items (paced)",
  "B2": "block-uniform over passed",
  "B3": "block warning-boost over passed (base qbar/P(pass), boost 2.5x base)",
  "B4": "uncertainty u(1-u) on passed",
  "B5": "score-stratified P(Z|h) on passed strata",
  "B6": "Neyman sqrt(p_h(1-p_h)) on passed strata"
 },
